FROM python:3.12-slim
WORKDIR /app
COPY panel ./panel
COPY core ./core
COPY data ./data
RUN useradd --system --uid 10001 --create-home sentinel && mkdir /state && chown sentinel:sentinel /state
USER sentinel
ENV PYTHONUNBUFFERED=1 SENTINEL_HOST=0.0.0.0 SENTINEL_PORT=8080 SENTINEL_DATA=/state
EXPOSE 8080
VOLUME ["/state"]
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz',timeout=3)"
CMD ["python", "-m", "panel.server"]
